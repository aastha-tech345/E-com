# Auto detect text files and normalize line endings to LF
* text=auto

# Explicitly define text files
*.md text
*.txt text
*.json text
*.yaml text
*.yml text
*.env.example text
*.sh text
*.py text
*.tsx text
*.ts text
*.jsx text
*.js text
*.css text
*.html text
*.xml text

# Explicitly define binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.db binary
*.sqlite binary
*.zip binary
*.tar binary
*.gz binary
