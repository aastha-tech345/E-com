# Environment
APP_ENV=production

# API Configuration
API_PREFIX=/api/v1
SECRET_KEY=change-me-in-production

# Database
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/marketplace

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "https://yourdomain.com"]

# Auth
ACCESS_TOKEN_EXPIRY_MINUTES=30

# Features
AUTO_CREATE_TABLES=false
SECURE_COOKIES=true

# Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-in-production

# Redis
REDIS_URL=redis://localhost:6379/0

# Cache
CACHE_TTL_SECONDS=300

# Rate Limiting
RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT=10
PUBLIC_SEARCH_RATE_LIMIT=60
ASSISTANT_RATE_LIMIT=20

# AI Assistant
AI_ASSISTANT_ENABLED=true
AI_PROVIDER=rule_based
AI_MODEL=marketplace-assistant-v1
AI_TEMPERATURE=0.1
AI_MAX_CONTEXT_MESSAGES=12
AI_TOOL_TIMEOUT_SECONDS=8
AI_CACHE_TTL_SECONDS=120
AI_ALLOW_WRITE_ACTIONS=false
